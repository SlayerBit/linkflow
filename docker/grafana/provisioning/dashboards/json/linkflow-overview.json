      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"linkflow-app\",status=~\"5..\",uri!~\"/actuator.*\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"linkflow-app\",uri!~\"/actuator.*\"}[5m])), 0.001)",
