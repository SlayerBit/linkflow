FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /app
COPY pom.xml .
COPY linkflow-common/pom.xml linkflow-common/
COPY linkflow-auth/pom.xml linkflow-auth/
COPY linkflow-user/pom.xml linkflow-user/
COPY linkflow-url/pom.xml linkflow-url/
COPY linkflow-rate-limit/pom.xml linkflow-rate-limit/
COPY linkflow-analytics/pom.xml linkflow-analytics/
COPY linkflow-observability/pom.xml linkflow-observability/
COPY linkflow-app/pom.xml linkflow-app/
COPY linkflow-gateway/pom.xml linkflow-gateway/
COPY linkflow-web/pom.xml linkflow-web/
RUN apk add --no-cache maven
RUN mvn -B -pl linkflow-web dependency:go-offline -DskipTests

COPY linkflow-web linkflow-web/
RUN mvn -B -pl linkflow-web package -DskipTests

FROM eclipse-temurin:21-jre-alpine
RUN apk add --no-cache curl
WORKDIR /app
COPY --from=build /app/linkflow-web/target/linkflow-web-*.jar app.jar
EXPOSE 8082
ENTRYPOINT ["java", "-jar", "app.jar"]
