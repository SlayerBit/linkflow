                    </mdc>
                    <pattern>
                        <pattern>
                            {
                              "service": "${APP_NAME}",
                              "module": "%logger{36}",
                              "message": "%maskedMessage"
                            }
                        </pattern>
                    </pattern>
                    <stackTrace>
                        <fieldName>stackTrace</fieldName>
                    </stackTrace>
                </providers>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
