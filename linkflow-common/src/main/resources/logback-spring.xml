                    </logLevel>
                    <loggerName>
                        <fieldName>logger</fieldName>
                    </loggerName>
                    <mdc>
                        <includeMdcKeyName>correlationId</includeMdcKeyName>
                    </mdc>
                    <pattern>
                        <pattern>
                            {
                              "service": "${APP_NAME}",
                              "module": "%logger{36}",
