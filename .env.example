# ---------------------------------------------------------------------------
# Database
#
# Docker Compose bundles PostgreSQL, so leaving SPRING_DATASOURCE_* unset is enough to bring the
# whole stack up. The POSTGRES_* values below configure that container and are what the app falls
# back to.
#
# Running the JARs directly (outside Compose) has no such fallback: SPRING_DATASOURCE_URL has no
# default and startup fails without it. Point it at localhost:5432, or at a managed database.
# ---------------------------------------------------------------------------
POSTGRES_DB=linkflow
POSTGRES_USER=linkflow
POSTGRES_PASSWORD=linkflow-local-postgres

# Set these to use a managed database instead of the bundled container. They take precedence.
# Example (Neon): jdbc:postgresql://<HOST>/neondb?sslmode=require&channelBinding=require
#SPRING_DATASOURCE_URL=
#SPRING_DATASOURCE_USERNAME=
#SPRING_DATASOURCE_PASSWORD=

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
# Required under the prod profile: Redis holds sessions, refresh-token state, and rate-limit
# counters. Also consumed by docker-compose as the Redis container's own password.
REDIS_PASSWORD=linkflow-local-redis
SPRING_DATA_REDIS_PASSWORD=linkflow-local-redis
# Compose caps Redis memory with eviction disabled, so it refuses writes rather than silently
# discarding live sessions. Raise this if the click-event buffer backs up under sustained load.
REDIS_MAXMEMORY=256mb

# JWT
# Required in production. Must decode to at least 64 bytes — that is the decoded length, not the
# length of the Base64 string. Generate with: openssl rand -base64 64
LINKFLOW_JWT_SECRET=

# Application
LINKFLOW_BASE_URL=http://localhost:8080
LINKFLOW_JWT_ACCESS_EXPIRATION_MS=900000
LINKFLOW_JWT_REFRESH_EXPIRATION_MS=2592000000
# '*' is rejected under the prod profile: combined with credentialed requests it would let any
# site call the API as a signed-in user. List explicit origins, comma-separated.
LINKFLOW_CORS_ALLOWED_ORIGINS=*

# Proxies permitted to assert the client IP via X-Forwarded-For / X-Real-IP, comma-separated
# CIDRs. Empty means the headers are ignored entirely, so an attacker cannot bypass IP rate
# limiting by sending one. Set this to your reverse proxy when running behind Nginx or a load
# balancer, otherwise every client is rate limited as a single address.
#
# Name the proxy hops as precisely as you can. A broad range such as 172.16.0.0/12 will usually
# also cover the addresses real clients arrive from, and every one of them is then treated as a
# proxy — collapsing all traffic into one rate-limit bucket. Compose sets this to the two
# /32 addresses of its Nginx and gateway containers for exactly that reason.
LINKFLOW_TRUSTED_PROXIES=

# Rate limiting
LINKFLOW_RATE_LIMIT_USER_RPM=100
LINKFLOW_RATE_LIMIT_IP_RPM=200
LINKFLOW_RATE_LIMIT_AUTH_FAIL_CLOSED=true

# Analytics retention
LINKFLOW_ANALYTICS_CLICK_EVENTS_RETENTION_DAYS=365

# Refresh token cleanup
LINKFLOW_AUTH_REFRESH_TOKEN_REVOKED_RETENTION_DAYS=7

# Security (dev defaults; prod profile overrides in application-prod.yml)
LINKFLOW_SECURITY_SWAGGER_PUBLIC=true
LINKFLOW_SECURITY_ACTUATOR_PUBLIC=true
LINKFLOW_SECURITY_METRICS_PUBLIC=false
LINKFLOW_SECURITY_EMAIL_VERIFICATION_REQUIRED=true
# Prod profile alias:
LINKFLOW_METRICS_PUBLIC=false

# ---------------------------------------------------------------------------
# Email (SMTP)
#
# Account activation and password reset depend on this. Under the prod profile the application
# refuses to start if it is misconfigured, because a locked-out user has no other way back in.
#
# Local development: run `docker compose up -d mailhog` and read mail at http://localhost:8025
# — the defaults below already point at it.
# ---------------------------------------------------------------------------
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Enable both for a real relay (SES, SendGrid, Postmark, Mailgun, ...)
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS=false

# Set false only outside production: messages are logged and discarded rather than sent.
LINKFLOW_MAIL_ENABLED=true
# Must be on a domain you control, with SPF/DKIM permitting your relay, or mail lands in spam.
LINKFLOW_MAIL_FROM=no-reply@linkflow.local
LINKFLOW_MAIL_FROM_NAME=LinkFlow
# Public origin used to build links in emails — must be https in production.
LINKFLOW_MAIL_BASE_URL=http://localhost:8080
LINKFLOW_MAIL_MAX_ATTEMPTS=3
LINKFLOW_MAIL_RETRY_BACKOFF_MS=1000

# Minimum gap between emails of the same kind to the same address.
#
# Resend-verification and forgot-password both take an address and send mail to it, so the IP rate
# limit alone lets one caller point the application at a stranger's inbox. This throttles by
# recipient instead. Raise it if your relay charges per message; 0 disables it.
LINKFLOW_MAIL_COOLDOWN_INTERVAL=60s

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
LINKFLOW_URL_EXPIRED_CLEANUP_CRON=0 0 * * * *

# Spent and expired verification, reset, and email-change tokens are kept this long before being
# deleted, so support can still tell "this link was already used" from "this link never existed".
LINKFLOW_AUTH_SINGLE_USE_TOKEN_RETENTION_DAYS=7
LINKFLOW_AUTH_SINGLE_USE_TOKEN_CLEANUP_CRON=0 45 3 * * *

# Gateway upstreams (local JAR runs)
LINKFLOW_APP_URI=http://127.0.0.1:8081
LINKFLOW_WEB_URI=http://127.0.0.1:8082
LINKFLOW_GATEWAY_URL=http://127.0.0.1:8080

# Admin bootstrap (optional, idempotent)
# Creates the first admin account on startup. Startup fails if enabled without both values set,
# and the prod profile additionally requires a password of at least 12 characters. Disable this
# again once the account exists.
LINKFLOW_BOOTSTRAP_ADMIN_ENABLED=false
LINKFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
LINKFLOW_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Grafana (docker-compose only)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
