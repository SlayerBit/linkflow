# Local TLS material, generated by infrastructure/nginx/generate-dev-certs.sh. Not committed: the
# key is private by definition, and a self-signed certificate expires and is trivially regenerated.
infrastructure/nginx/certs/*
!infrastructure/nginx/certs/.gitkeep

# k6 local seed + reports (suite is tracked; results are not)
performance/data/seed.json
performance/reports/*
!performance/reports/.gitkeep
linkflow-images.tar
