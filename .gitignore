# Docker local overrides (keep compose files tracked)
docker-compose.override.yml

# Local TLS material, generated by docker/nginx/generate-dev-certs.sh. Not committed: the key is
# private by definition, and a self-signed certificate expires and is trivially regenerated.
docker/nginx/certs/*
!docker/nginx/certs/.gitkeep

# k6 local seed + reports (suite is tracked; results are not)
performance/data/seed.json
performance/reports/*
!performance/reports/.gitkeep
