# ===========================================================================
# LinkFlow — 4-EC2 Production Environment Configuration Template
# ===========================================================================
# Copy this file to `.env` on each EC2 instance and replace placeholder values.
#
# IMPORTANT:
# - Do NOT commit actual `.env` files containing production secrets to Git!
# - Ensure LINKFLOW_JWT_SECRET, REDIS_PASSWORD, and SPRING_DATASOURCE_PASSWORD
#   are strong and identical across all application instances.
# ===========================================================================

# ===========================================================================
# SECTION A: EC2 #1 — EDGE / INFRASTRUCTURE STACK
# (Used by docker-compose.ec2-edge.yml)
# ===========================================================================

# Consumed by Redis container as authentication password
REDIS_PASSWORD=<GENERATE_STRONG_REDIS_PASSWORD>
REDIS_MAXMEMORY=256mb

# Private IP of EC2 #1. Limits Redis listener to private VPC interface only!
REDIS_BIND_ADDRESS=<EC2_1_PRIVATE_IP>

# Private IPs of the 3 application nodes. Nginx and Prometheus use these to
# resolve the stable upstream names app1, app2, app3 via Docker extra_hosts.
APP_NODE_1_IP=<EC2_2_PRIVATE_IP>
APP_NODE_2_IP=<EC2_3_PRIVATE_IP>
APP_NODE_3_IP=<EC2_4_PRIVATE_IP>

# Domain name for Nginx server_name and Let's Encrypt certificate.
# Used by documentation only — the Nginx config itself uses server_name _
# and certbot uses --cert-name linkflow.
DOMAIN_NAME=yourdomain.com

# Grafana admin credentials (accessible via SSH tunnel on localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<STRONG_GRAFANA_PASSWORD>


# ===========================================================================
# SECTION B: EC2 #2 / #3 / #4 — APPLICATION NODE STACK
# (Used by docker-compose.ec2-app.yml)
# ===========================================================================

# ---------------------------------------------------------------------------
# Container Image Registry
# ---------------------------------------------------------------------------
# Trailing slash required for ECR. Leave empty or unset for local builds.
# Example: 123456789012.dkr.ecr.ap-south-1.amazonaws.com/
REGISTRY=<AWS_ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/

# Image tag — updated automatically by scripts/deploy.sh during CI/CD.
# Do not edit manually unless performing a manual deployment or rollback.
IMAGE_TAG=latest

# AWS region for ECR login (used by deploy.sh and rollback.sh)
AWS_REGION=<REGION>

# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# ---------------------------------------------------------------------------
# Example Neon URL: jdbc:postgresql://ep-xyz.ap-southeast-1.aws.neon.tech/linkflow?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://<NEON_HOST>:5432/<DB_NAME>?sslmode=require
SPRING_DATASOURCE_USERNAME=<NEON_USER>
SPRING_DATASOURCE_PASSWORD=<NEON_PASSWORD>

# ---------------------------------------------------------------------------
# Redis Connection (points to EC2 #1)
# ---------------------------------------------------------------------------
# Private IP of EC2 #1 (e.g. 10.0.1.100)
REDIS_HOST=<EC2_1_PRIVATE_IP>
REDIS_PASSWORD=<SAME_REDIS_PASSWORD_AS_SECTION_A>

# ---------------------------------------------------------------------------
# Application Security & Origins
# ---------------------------------------------------------------------------
# Secret MUST decode to at least 64 bytes.
# Generate with: openssl rand -base64 64
LINKFLOW_JWT_SECRET=<GENERATE_WITH_OPENSSL_RAND_BASE64_64>

# Public domain origin (HTTPS required in prod profile)
LINKFLOW_BASE_URL=https://yourdomain.com
LINKFLOW_CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Gateway container IP on local Docker bridge network
LINKFLOW_TRUSTED_PROXIES=172.20.0.10/32

# Expose /actuator/prometheus to internal VPC scraper (EC2 #1)
LINKFLOW_METRICS_PUBLIC=true

# Session cookie must be Secure behind HTTPS edge. Override to false only
# when testing locally without TLS.
SERVER_SERVLET_SESSION_COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Mail / SMTP Relay (SES, SendGrid, Postmark, etc.)
# Note: MailConfigValidator will block startup under 'prod' profile if
# SMTP host is missing or from-address/base-url use placeholders.
# ---------------------------------------------------------------------------
SPRING_MAIL_HOST=email-smtp.ap-southeast-1.amazonaws.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<SMTP_USERNAME>
SPRING_MAIL_PASSWORD=<SMTP_PASSWORD>
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true

LINKFLOW_MAIL_FROM=no-reply@yourdomain.com
LINKFLOW_MAIL_BASE_URL=https://yourdomain.com

# ---------------------------------------------------------------------------
# First Admin Account Bootstrap (Optional — run once on initial deploy)
# ---------------------------------------------------------------------------
LINKFLOW_BOOTSTRAP_ADMIN_ENABLED=false
LINKFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
LINKFLOW_BOOTSTRAP_ADMIN_PASSWORD=<STRONG_ADMIN_PASSWORD_AT_LEAST_12_CHARS>
